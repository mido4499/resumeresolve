# Copy to .env (locally) or set in your host's environment settings (production). Never commit real values.

# Postgres connection string
DATABASE_URL=

# Signs session cookies. Generate one with: npx auth secret
AUTH_SECRET=

# The site's public address, with no trailing slash, e.g. https://rolediary.com
# Required in production: links in verification and password-reset emails use it.
AUTH_URL=

# Claude API key, for resume generation
ANTHROPIC_API_KEY=

# Resend API key and sender, for verification and password-reset emails
RESEND_API_KEY=
EMAIL_FROM="Role Diary <no-reply@your-domain.com>"
