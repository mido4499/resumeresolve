// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  password            String?
  image               String?
  phone               String?
  // Set when the user clicks the link in the verification email
  emailVerified       DateTime?
  // Set when the user finishes (or skips) the "complete account" step
  onboardedAt         DateTime?
  // Set when the user agrees to the privacy policy at sign-up
  privacyAcceptedAt   DateTime?
  // Set when the user agrees to the terms of service at sign-up
  termsAcceptedAt     DateTime?
  createdAt           DateTime             @default(now())
  experiences         Experience[]
  education           Education[]
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
}

// Only a hash of the token is stored, so a database leak can't be used to verify emails
model VerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  // The address being verified: the account's email at sign-up, or the new address when changing it
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Links from "Forgot password" emails. Kept apart from VerificationToken so asking for a reset
// doesn't cancel a pending email verification. Only a hash of the token is stored.
model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Relevant coursework is not stored here: the user enters it on every generation
model Education {
  id             String    @id @default(cuid())
  school         String?
  major          String?
  minor          String?
  graduationDate DateTime?
  graduated      Boolean?
  gpa            String?
  achievements   String?
  createdAt      DateTime  @default(now())
  userId         String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Experience {
  id        String    @id @default(cuid())
  place     String    @default("")
  role      String
  startDate DateTime
  // null means the job or project is ongoing ("Present")
  endDate   DateTime?
  createdAt DateTime  @default(now())
  userId    String

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions Contribution[]
}

model Contribution {
  id           String     @id @default(cuid())
  entry        String
  createdAt    DateTime   @default(now())
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
}

// Fixed-window counters for rate limits (sign-in attempts, sign-ups, reset emails, daily generations).
// Keyed like "signin:ip:1.2.3.4" or "generate:<userId>"; expired rows are cleaned up as they're found.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}
